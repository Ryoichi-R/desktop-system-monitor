<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DesktopSystemMonitor.Avalonia.PoC.MainWindow"
        Width="420"
        Height="260"
        MinWidth="320"
        MinHeight="200"
        Title="Desktop System Monitor PoC"
        WindowStartupLocation="CenterScreen">
  <Border Padding="20">
    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
      <TextBlock x:Name="StatusText"
                 FontSize="20"
                 Text="Desktop System Monitor" />
      <TextBox x:Name="SettingsTextBox"
               Grid.Row="1"
               Watermark="設定値"
               Text="通常" />
      <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
        <Button x:Name="ApplyButton"
                Content="設定を適用"
                Click="OnApplyClick" />
        <Button x:Name="ToggleStateButton"
                Content="最大化"
                Click="OnToggleStateClick" />
      </StackPanel>
      <TextBlock x:Name="AppliedText"
                 Grid.Row="3"
                 VerticalAlignment="Top"
                 Text="未適用" />
    </Grid>
  </Border>
</Window>
