<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DesktopSystemMonitor.App.AvaloniaMainWindow"
        Width="420"
        Height="260"
        MinWidth="320"
        MinHeight="200"
        Title="Desktop System Monitor"
        WindowStartupLocation="CenterScreen">
  <Border Padding="20">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="10">
      <TextBlock x:Name="TitleText"
                 FontSize="20"
                 Text="Desktop System Monitor" />
      <TextBlock x:Name="StatusText"
                 Grid.Row="1"
                 Text="ネイティブ指標: N/A" />
      <StackPanel Grid.Row="2" Spacing="4">
        <TextBlock x:Name="CpuText" Text="CPU: N/A" />
        <TextBlock x:Name="MemoryText" Text="メモリ: N/A" />
        <TextBlock x:Name="GpuText" Text="GPU: N/A" />
      </StackPanel>
      <Button x:Name="RefreshButton"
              Grid.Row="3"
              HorizontalAlignment="Left"
              Content="状態を再確認"
              Click="OnRefreshClick" />
      <TextBlock x:Name="SafetyText"
                 Grid.Row="4"
                 TextWrapping="Wrap"
                 Text="未実装または取得不能な指標は推測せず N/A として表示します。" />
    </Grid>
  </Border>
</Window>
