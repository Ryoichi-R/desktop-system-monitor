<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>DesktopSystemMonitor.App</RootNamespace>
    <AssemblyName>DesktopSystemMonitor</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\DesktopSystemMonitor.ico</ApplicationIcon>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Platforms>AnyCPU;x64;ARM64</Platforms>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <IncludeAllContentForSelfExtract>false</IncludeAllContentForSelfExtract>
    <!--
      WFO0003: WinForms wants Application.SetHighDpiMode, but this is primarily
      a WPF app and DPI is configured via app.manifest (PerMonitorV2).
      NotifyIcon is the only WinForms consumer and it does not draw scaled
      surfaces itself.
    -->
    <NoWarn>$(NoWarn);CA1416;WFO0003</NoWarn>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DesktopSystemMonitor.Core\DesktopSystemMonitor.Core.csproj" />
    <ProjectReference Include="..\DesktopSystemMonitor.Windows\DesktopSystemMonitor.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DesktopSystemMonitor.App.Tests" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\DesktopSystemMonitor.ico"
                      LogicalName="DesktopSystemMonitor.App.Assets.DesktopSystemMonitor.ico" />
    <Resource Include="Assets\DesktopSystemMonitorIcon-v2.png" />
  </ItemGroup>
</Project>
