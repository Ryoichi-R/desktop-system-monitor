<Application x:Class="DesktopSystemMonitor.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="WidgetForeground" Color="#FFF3F3F3" />
            <SolidColorBrush x:Key="WidgetMuted" Color="#FFB0B0B0" />
            <SolidColorBrush x:Key="WidgetAccent" Color="#FF7DC8FF" />
            <SolidColorBrush x:Key="WidgetRxAccent" Color="#FF5DCAA5" />
            <SolidColorBrush x:Key="WidgetTxAccent" Color="#FFEF9F27" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
