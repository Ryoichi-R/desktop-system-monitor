<Window x:Class="DesktopSystemMonitor.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop System Monitor 設定" Width="720" Height="610"
        Icon="Assets/DesktopSystemMonitorIcon-v2.png"
        MinWidth="680" MinHeight="520" WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" ShowInTaskbar="False">
  <DockPanel Margin="16">
    <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="ValidationMessage" Foreground="Crimson" VerticalAlignment="Center" TextWrapping="Wrap"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="キャンセル" Width="88" Margin="8,0" IsCancel="True"/><Button x:Name="SaveButton" Content="保存" Width="88" IsDefault="True" Click="Save_Click"/></StackPanel>
    </Grid>
    <TabControl x:Name="CategoryTabs" TabStripPlacement="Left" SelectedIndex="0">
      <TabControl.Resources>
        <Style TargetType="TabItem"><Setter Property="Width" Value="148"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="12,9"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Margin" Value="4,7"/></Style>
        <Style x:Key="FieldGrid" TargetType="Grid"><Setter Property="Margin" Value="4,3"/></Style>
      </TabControl.Resources>
      <TabItem Header="全体設定">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
          <TextBlock Text="全体設定" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
          <Grid Style="{StaticResource FieldGrid}"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="更新間隔（0.5～5秒）" VerticalAlignment="Center"/><TextBox x:Name="IntervalBox" Grid.Column="1"/></Grid>
          <Grid Style="{StaticResource FieldGrid}"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="表示倍率（75～200%）" VerticalAlignment="Center"/><TextBox x:Name="ScaleBox" Grid.Column="1"/></Grid>
          <Grid Style="{StaticResource FieldGrid}"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="表示階層" VerticalAlignment="Center"/><ComboBox x:Name="LayerBox" Grid.Column="1" SelectionChanged="Layer_Changed"><ComboBoxItem Content="常に手前（透明オーバーレイ推奨）" Tag="AlwaysOnTop"/><ComboBoxItem Content="デスクトップ上" Tag="OnDesktop"/><ComboBoxItem Content="通常（安全フォールバック）" Tag="Normal"/></ComboBox></Grid>
          <CheckBox x:Name="ClickThroughBox" Content="クリックを透過する"/><CheckBox x:Name="AutoHideBox" Content="フルスクリーンアプリで自動的に隠す"/><CheckBox x:Name="StartupBox" Content="Windowsログオン時に自動起動する"/><CheckBox x:Name="DiagnosticBox" Content="診断ログを有効にする（最大1 MB × 5世代）"/><CheckBox x:Name="ShowPeaksBox" Content="CPU・MEM・GPU・DISKの直近ピークマーカーを表示"/>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="表示位置">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
          <TextBlock Text="表示位置" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
          <Grid Style="{StaticResource FieldGrid}"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="表示モニター" VerticalAlignment="Center"/><ComboBox x:Name="MonitorBox" Grid.Column="1" DisplayMemberPath="Label" SelectionChanged="PlacementPreset_Changed"/></Grid>
          <Grid Style="{StaticResource FieldGrid}"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="基準位置" VerticalAlignment="Center"/><ComboBox x:Name="PlacementAnchorBox" Grid.Column="1" DisplayMemberPath="Label" SelectionChanged="PlacementPreset_Changed"/></Grid>
          <Grid Style="{StaticResource FieldGrid}"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="水平余白（0～200 DIP）" VerticalAlignment="Center"/><TextBox x:Name="HorizontalMarginBox" Grid.Column="1" TextChanged="PlacementPreset_Changed"/></Grid>
          <Grid Style="{StaticResource FieldGrid}"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="垂直余白（0～200 DIP）" VerticalAlignment="Center"/><TextBox x:Name="VerticalMarginBox" Grid.Column="1" TextChanged="PlacementPreset_Changed"/></Grid>
          <WrapPanel Margin="4,12,4,4"><Button Content="現在位置を使用" Padding="12,5" Margin="0,0,8,0" Click="UseCurrentPosition_Click"/><Button Content="既定の右上へ戻す" Padding="12,5" Click="ResetPosition_Click"/></WrapPanel>
          <TextBlock x:Name="PlacementStatusText" Margin="4,8" Foreground="Gray" TextWrapping="Wrap"/>
          <TextBlock Text="クリック透過を解除すると、メイン表示をドラッグして移動できます。ドラッグ後の位置は自動保存されます。" Margin="4,12" Foreground="Gray" TextWrapping="Wrap"/>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="外観"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16"><TextBlock Text="外観" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <TextBlock Text="フォント"/><TextBox x:Name="FontBox" Margin="4"/><TextBlock Text="文字色（#RRGGBB / #AARRGGBB）"/><TextBox x:Name="ForegroundBox" Margin="4"/><TextBlock Text="補助文字色"/><TextBox x:Name="MutedBox" Margin="4"/><TextBlock Text="アクセント色・負荷バー色"/><TextBox x:Name="AccentBox" Margin="4"/><TextBlock Text="受信矢印色"/><TextBox x:Name="RxAccentBox" Margin="4"/><TextBlock Text="送信矢印色"/><TextBox x:Name="TxAccentBox" Margin="4"/>
        <Separator Margin="4,12"/><CheckBox x:Name="BackgroundEnabledBox" Content="背景を表示" Checked="BackgroundSetting_Changed" Unchecked="BackgroundSetting_Changed"/>
        <TextBlock Text="背景色（#RRGGBB）"/><Grid Margin="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBox x:Name="BackgroundColorBox" TextChanged="BackgroundColor_Changed"/><Border Grid.Column="1" Margin="6,0" BorderBrush="Gray" BorderThickness="1"><Border x:Name="BackgroundColorPreviewFadeHost"><Border x:Name="BackgroundColorPreview" Background="Transparent"/></Border></Border><Button x:Name="ChooseBackgroundColorButton" Grid.Column="2" Content="色を選択" Click="ChooseBackgroundColor_Click"/></Grid>
        <TextBlock Text="背景の不透明度"/><Grid Margin="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions><Slider x:Name="BackgroundOpacitySlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="BackgroundOpacity_Changed"/><TextBlock x:Name="BackgroundOpacityText" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
        <TextBlock Text="背景の塗り方"/><ComboBox x:Name="BackgroundFillModeBox" Margin="4" SelectionChanged="BackgroundGradientSetting_Changed"><ComboBoxItem Content="単色" Tag="Solid"/><ComboBoxItem Content="左・下端を透明にするグラデーション" Tag="EdgeFade"/></ComboBox>
        <TextBlock Text="文字領域外のグラデーション幅"/><Grid Margin="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions><Slider x:Name="BackgroundEdgeFadeSlider" Minimum="5" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="BackgroundGradientSetting_Changed"/><TextBlock x:Name="BackgroundEdgeFadeText" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
        <CheckBox x:Name="HideBackgroundBehindWindowsBox" Content="他のウィンドウと重なる部分では背景だけ隠す"/><TextBlock x:Name="BackgroundLayerHint" Margin="24,2,4,4" Foreground="Gray" TextWrapping="Wrap"/>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="CPU"><StackPanel Margin="16"><TextBlock Text="CPU" FontSize="18" FontWeight="SemiBold"/><CheckBox x:Name="ShowCpuBox" Content="CPU行を表示" Checked="CpuToggle_Changed" Unchecked="CpuToggle_Changed" AutomationProperties.Name="CPU行を表示"/><CheckBox x:Name="ShowCpuTemperatureBox" Content="CPU温度を表示" AutomationProperties.Name="CPU温度を表示"/><TextBlock Text="CPU温度の取得にはPawnIOが必要です。本アプリは自動導入しないため、利用できない場合はN/Aになります。" Margin="24,4" Foreground="Gray" TextWrapping="Wrap"/><TextBlock x:Name="CpuTemperatureCapabilityText" Margin="24,4" Foreground="Gray"/></StackPanel></TabItem>
      <TabItem Header="GPU"><StackPanel Margin="16"><TextBlock Text="GPU" FontSize="18" FontWeight="SemiBold"/><CheckBox x:Name="ShowGpuBox" Content="GPU行を表示" Checked="GpuToggle_Changed" Unchecked="GpuToggle_Changed" AutomationProperties.Name="GPU行を表示"/><CheckBox x:Name="ShowGpuTemperatureBox" Content="GPU温度を表示" AutomationProperties.Name="GPU温度を表示"/><TextBlock x:Name="GpuTemperatureCapabilityText" Margin="24,4" Foreground="Gray"/><TextBlock Text="固定GPU LUID（任意、16進）" Margin="4,12,4,0"/><TextBox x:Name="GpuLuidBox" Margin="4" ToolTip="例: 0000000100001234"/></StackPanel></TabItem>
      <TabItem Header="DISK"><StackPanel Margin="16"><TextBlock Text="DISK" FontSize="18" FontWeight="SemiBold"/><CheckBox x:Name="ShowDiskBox" Content="物理ディスクの稼働率・読込・書込を表示" Checked="DiskToggle_Changed" Unchecked="DiskToggle_Changed"/><TextBlock Text="監視する物理ディスク" Margin="4,8,4,0"/><ComboBox x:Name="PhysicalDiskBox" Margin="4" DisplayMemberPath="Label"/><TextBlock x:Name="DiskStatusText" Margin="4,12" Foreground="Gray" TextWrapping="Wrap"/></StackPanel></TabItem>
      <TabItem Header="NET"><StackPanel Margin="16"><TextBlock Text="NET" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="通信速度の単位" Margin="4,10,4,0"/><ComboBox x:Name="UnitBox" Margin="4"><ComboBoxItem Content="Bytes/s（自動）" Tag="DecimalBytes"/><ComboBoxItem Content="bits/s（自動）" Tag="DecimalBits"/><ComboBoxItem Content="Kb/s固定" Tag="FixedKilobitsPerSecond"/></ComboBox><TextBlock Text="Network LUID（任意、カンマ区切り）" Margin="4,10,4,0"/><TextBox x:Name="NetworkLuidsBox" Margin="4"/><CheckBox x:Name="ShowNetworkPeaksBox" Content="受信・送信速度の直近MAXを表示" Checked="NetworkPeakToggle_Changed" Unchecked="NetworkPeakToggle_Changed"/><TextBlock Text="MAX集計期間（10～60秒）" Margin="4,10,4,0"/><TextBox x:Name="NetworkPeakWindowBox" Margin="4" AutomationProperties.Name="NET MAX集計期間"/></StackPanel></TabItem>
      <TabItem Header="BAT"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16"><TextBlock Text="BAT" FontSize="18" FontWeight="SemiBold"/><CheckBox x:Name="ShowBatteryBox" Content="バッテリー残量・充放電電力・推定時間を表示"/><TextBlock x:Name="BatteryCapabilityText" Margin="24,4" Foreground="Gray"/><TextBlock Text="充電目標" Margin="4,14,4,0"/><ComboBox x:Name="BatteryChargeModeBox" Margin="4" SelectionChanged="BatteryChargeMode_Changed"><ComboBoxItem Content="自動（停止位置を2回観測して学習）" Tag="Auto"/><ComboBoxItem Content="手動" Tag="Manual"/></ComboBox><TextBlock Text="手動目標（50～100%）" Margin="4,8,4,0"/><TextBox x:Name="BatteryChargeTargetBox" Margin="4" AutomationProperties.Name="手動充電目標"/><TextBlock x:Name="BatteryChargeLearningStatusText" Margin="4,10,4,4" Foreground="Gray" TextWrapping="Wrap"/><Button x:Name="ResetBatteryChargeLearningButton" Content="学習値をリセット" Width="140" HorizontalAlignment="Left" Margin="4" Click="ResetBatteryChargeLearning_Click"/><TextBlock Text="充電時間は直近約60秒の有効な充電率からの概算です。終盤の出力低下、温度、負荷、充電器により変動します。自動モードはメーカー設定を直接取得せず、観測から推定します。" TextWrapping="Wrap" Margin="4,14"/></StackPanel></ScrollViewer></TabItem>
      <TabItem Header="プロセス"><StackPanel Margin="16"><TextBlock Text="プロセス" FontSize="18" FontWeight="SemiBold"/><CheckBox x:Name="ProcessDetailsBox" Content="高負荷プロセス詳細を有効にする"/><TextBlock Text="詳細画面を開いている間だけプロセス情報をサンプリングします。" TextWrapping="Wrap" Margin="4,12"/></StackPanel></TabItem>
    </TabControl>
  </DockPanel>
</Window>
