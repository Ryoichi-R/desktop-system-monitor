{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "product", "source", "toolchain", "readiness", "artifacts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "product": {
      "type": "object",
      "required": ["name", "version", "tag"],
      "properties": {
        "name": { "const": "Desktop System Monitor" },
        "version": { "type": "string" },
        "tag": { "type": "string", "pattern": "^v" }
      }
    },
    "source": {
      "type": "object",
      "required": ["commit", "treeDigest", "candidateLineageId"],
      "properties": {
        "commit": { "type": ["string", "null"] },
        "treeDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "candidateLineageId": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "toolchain": { "type": "object" },
    "readiness": { "type": "object" },
    "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rid", "fileName", "bytes", "sha256", "peMachine", "preSignExecutableSha256", "packagedExecutableSha256", "signatureStatus", "signatureSubject", "unsignedWaiver", "legalFiles"],
      "properties": {
        "rid": { "enum": ["win-x64", "win-arm64"] },
        "fileName": { "type": "string" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "peMachine": { "type": "string" },
        "preSignExecutableSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "packagedExecutableSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "signatureStatus": { "enum": ["unsigned", "valid"] },
        "signatureSubject": { "type": ["string", "null"] },
        "unsignedWaiver": {
          "type": ["object", "null"],
          "required": ["owner", "reason", "expiresAt"],
          "properties": {
            "owner": { "type": "string", "minLength": 1 },
            "reason": { "type": "string", "minLength": 1 },
            "expiresAt": { "type": "string", "format": "date-time" }
          },
          "additionalProperties": false
        },
        "legalFiles": { "type": "array", "minItems": 3, "items": { "type": "string" } }
      },
      "allOf": [
        {
          "if": { "properties": { "signatureStatus": { "const": "valid" } } },
          "then": {
            "properties": {
              "signatureSubject": { "type": "string", "minLength": 1 },
              "unsignedWaiver": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "signatureSubject": { "type": "null" },
              "unsignedWaiver": { "type": "object" }
            }
          }
        }
      ]
    }
  }
}
