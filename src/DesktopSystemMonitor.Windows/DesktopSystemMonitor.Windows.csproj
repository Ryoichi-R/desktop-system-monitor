<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>DesktopSystemMonitor.Windows</RootNamespace>
    <AssemblyName>DesktopSystemMonitor.Windows</AssemblyName>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Platforms>AnyCPU;x64;ARM64</Platforms>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DesktopSystemMonitor.Core\DesktopSystemMonitor.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DesktopSystemMonitor.Windows.Tests" />
    <InternalsVisibleTo Include="DesktopSystemMonitor.App.Tests" />
    <InternalsVisibleTo Include="DesktopSystemMonitor.IntegrationTests" />
    <InternalsVisibleTo Include="DesktopSystemMonitor.App" />
    <InternalsVisibleTo Include="DesktopSystemMonitor" />
    <InternalsVisibleTo Include="DesktopSystemMonitor.Diagnostics" />
  </ItemGroup>
</Project>
